<Window x:Class="Clicker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кликер" Height="680" Width="440"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="EnemyNameText" Grid.Row="0" FontSize="22" FontWeight="Bold"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="HealthText" Grid.Row="1" Margin="0,6,0,0" TextWrapping="Wrap"
                   HorizontalAlignment="Center" />
        <ProgressBar x:Name="HealthBar" Grid.Row="2" Height="16" Margin="0,6,0,0"
                     Minimum="0" Maximum="100" Foreground="Firebrick" />

        <Border x:Name="EnemyArea" Grid.Row="3" Margin="0,12" Background="Transparent"
                Cursor="Hand" MouseLeftButtonDown="EnemyArea_MouseLeftButtonDown">
            <Grid>
                <Image x:Name="EnemyImage" Stretch="Uniform" />
                <TextBlock x:Name="NoIconText" Text="(иконка не найдена)" Visibility="Collapsed"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Canvas x:Name="SphereLayer" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="4">
            <TextBlock x:Name="GoldText" FontSize="16" TextWrapping="Wrap" />
            <TextBlock x:Name="DamageText" FontSize="16" TextWrapping="Wrap" />
            <TextBlock x:Name="CooldownText" FontSize="14" TextWrapping="Wrap" />
            <TextBlock x:Name="EffectsText" FontSize="14" Foreground="DarkGreen" TextWrapping="Wrap" />
            <TextBlock x:Name="StageText" FontSize="14" Foreground="Gray" />
        </StackPanel>

        <Button x:Name="UpgradeButton" Grid.Row="5" Margin="0,12,0,0" Padding="8"
                Click="UpgradeButton_Click" />
        <Button x:Name="CooldownUpgradeButton" Grid.Row="6" Margin="0,6,0,0" Padding="8"
                Click="CooldownUpgradeButton_Click" />
    </Grid>
</Window>
